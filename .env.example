# HighLevel sandbox — Private Integration Token for the sandbox sub-account.
# Create in the sandbox: Settings > Private Integrations. Needs scopes:
# voice-ai-agents.readonly, voice-ai-agents.write, voice-ai-dashboard.readonly,
# voice-ai-agent-goals.readonly, voice-ai-agent-goals.write
GHL_PIT=
GHL_API_DOMAIN=https://services.leadconnectorhq.com
GHL_API_VERSION=v3
GHL_LOCATION_ID=

# LLM provider: "gemini" (free tier friendly) or "anthropic".
# If unset, Gemini is used when GEMINI_API_KEY is present, else Anthropic.
LLM_PROVIDER=gemini

# Gemini (Google AI Studio / Gemini API) — used when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional comma-separated fallbacks when primary returns 503/high demand
# GEMINI_MODEL_FALLBACKS=gemini-flash-lite-latest,gemini-2.0-flash-lite
# GEMINI_RETRY_ATTEMPTS=3

# Anthropic — used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Soft-stop further LLM calls once Anthropic response headers report remaining
# budget below these floors (defaults: 1 request / 500 tokens).
# ANTHROPIC_MIN_REQUESTS_REMAINING=1
# ANTHROPIC_MIN_TOKENS_REMAINING=500
# Synthetic backfill always generates exactly one deliberately-flawed transcript per issue
# category (6, fixed) so every category has real evidence for testgen/recommend to work from.
# This value controls only the number of ADDITIONAL clean happy-path transcripts on top of
# that. Set to 0 to sync agents/real calls only and skip synthetic backfill entirely.
# SEED_SYNTHETIC_COUNT=4

PORT=3000
DATABASE_PATH=./data/optimizer.sqlite

# Marketplace app OAuth client -- used only to complete the install handshake
# (GHL redirects here with ?code=... after the user approves the install).
# The resulting access token is not used anywhere; all real API calls use GHL_PIT above.
# Create in the Developer Portal: your app > Advanced Settings > Auth.
GHL_OAUTH_CLIENT_ID=
GHL_OAUTH_CLIENT_SECRET=
GHL_OAUTH_REDIRECT_URI=
